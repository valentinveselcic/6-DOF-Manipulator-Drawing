<?xml version="1.0" ?>
<robot name="rob_manipulator">
    <!-- Dijelovi robota-->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.28 0.28 0.2765" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0.13825" />
        </visual>
        <collision>
            <geometry>
                <box size="0.28 0.28 0.2765" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0.13825" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.0027" iyy="0.0027" izz="0.005" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0.13825" />
        </inertial>
    </link>
    <!-- Empty Link-->
    <link name="world" />
    <joint name="fixed" type="fixed">
        <parent link="world" />
        <child link="base_link" />
    </joint>

    <link name="link_1">
        <visual>
            <geometry>
                <box size="0.242 0.242 0.2635" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0.13175" />
        </visual>
        <collision>
            <geometry>
                <box size="0.242 0.242 0.2635" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0.13175" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.00145" iyy="0.00145" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0.13175" />
        </inertial>
    </link>
    <joint name="joint_1" type="continuous">
        <axis xyz="0 0 1" />
        <parent link="base_link" />
        <child link="link_1" />
        <origin rpy="0 0 0" xyz="0.0 0.0 0.2765" />
        <limit effort="300" velocity="1.0"/> 

    </joint>
    <link name="link_2">
        <visual>
            <geometry>
                <box size="0.245 0.245 0.87" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0.435" />
        </visual>
        <collision>
            <geometry>
                <box size="0.245 0.245 0.87" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0.435" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01396" iyy="0.01396" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0.435" />
        </inertial>
    </link>
    <joint name="joint_2" type="continuous">
        <axis xyz="1 0 0" />
        <parent link="link_1" />
        <child link="link_2" />
        <origin rpy="0 0 0" xyz="0 0 0.2635" />
        <limit effort="300" velocity="1.0"/> 
    </joint>
    <link name="link_3">
        <visual>
            <geometry>
                <box size="0.242 0.242 0.290" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0" />
        </visual>
        <visual>
            <geometry>
                <box size="0.242 0.242 0.6575" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0.242 0.18375" />
        </visual>
        <collision>
            <geometry>
                <box size="0.242 0.242 0.290" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0" />
        </collision>
        <collision>
            <geometry>
                <box size="0.242 0.242 0.6575" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0.242 0.18375" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01396" iyy="0.01396" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0" />
        </inertial>
    </link>
    <joint name="joint_3" type="continuous">
        <axis xyz="1 0 0" />
        <parent link="link_2" />
        <child link="link_3" />
        <origin rpy="0 0 0" xyz="0.242 0 0.87" />
        <limit effort="300" velocity="1.0"/> 
    </joint>
    <link name="link_4">
        <visual>
            <geometry>
                <cylinder length="0.5125" radius="0.1" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0.25625" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.5125" radius="0.1" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0.25625" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01396" iyy="0.01396" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0.25625" />
        </inertial>
    </link>
    <joint name="joint_4" type="continuous">
        <axis xyz="0 0 1" />
        <parent link="link_3" />
        <child link="link_4" />
        <origin rpy="0 0 0" xyz="0 0.242 0.5125" />
        <limit effort="300" velocity="1.0"/> 
    </joint>
    <link name="link_5">
        <visual>
            <geometry>
                <cylinder length="0.175" radius="0.1" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 0.0875" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.175" radius="0.1" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 0.0875" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01396" iyy="0.01396" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 0.0875" />
        </inertial>
    </link>
    <joint name="joint_5" type="continuous">
        <axis xyz="1 0 0" />
        <parent link="link_4" />
        <child link="link_5" />
        <origin rpy="0 0 0" xyz="0 0 0.5125" />
        <limit effort="300" velocity="1.0"/> 
    </joint>
    <link name="link_6">
        <visual>
            <geometry>
                <cylinder length="0.175" radius="0.03" />
            </geometry>
            <material name="silver">
                <color rgba="0.75 0.75 0.75 1" />
            </material>
            <origin rpy="0.0 0 0" xyz="0 0 -0.0875" />
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.175" radius="0.03" />
            </geometry>
            <origin rpy="0.0 0 0" xyz="0 0 -0.0875" />
        </collision>
        <inertial>
            <mass value="1.0" />
            <inertia ixx="0.01396" iyy="0.01396" izz="0.00125" ixy="0" ixz="0" iyz="0" />
            <origin rpy="0.0 0 0" xyz="0 0 -0.0875" />
        </inertial>
    </link>
    <joint name="joint_6" type="continuous">
        <axis xyz="0 0 1" />
        <parent link="link_5" />
        <child link="link_6" />
        <origin rpy="0 0 0" xyz="0 0 0.35" />
        <limit effort="300" velocity="1.0"/> 
    </joint>
    
    <gazebo reference="base_link">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_1">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_2">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_3">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_4">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_5">
        <material>Gazebo/Chrome</material>
    </gazebo>
    <gazebo reference="link_6">
        <material>Gazebo/Chrome</material>
    </gazebo>

    <!-- ros_control plugin -->
    <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find rob_manip_moveit)/config/ros2_controllers.yaml</parameters>
    </plugin>
</gazebo>

</robot>